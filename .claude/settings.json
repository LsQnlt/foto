{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git revert *)",
      "Bash(git cherry-pick *)",
      "Bash(git stash *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git tag *)",
      "Bash(git worktree *)",
      "Bash(git push *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(scalingo *)",
      "Bash(dokku *)",
      "Bash(kamal *)",
      "Bash(heroku *)"
    ],
    "deny": [
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(bundle install *)",
      "Bash(bundle update *)",
      "Bash(yarn install *)",
      "Bash(yarn add *)",
      "Bash(yarn up *)",
      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Bash(npm update *)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm update *)",
      "Bash(gem install *)",
      "Bash(gem update *)",
      "Bash(brew install *)",
      "Bash(brew upgrade *)",
      "Bash(rbenv install *)",
      "Bash(bin/rails db:migrate*)",
      "Bash(bin/rails db:rollback*)",
      "Bash(bin/rails db:prepare*)",
      "Bash(bin/rails db:reset*)",
      "Bash(bin/rails db:setup*)",
      "Bash(bin/rails db:seed*)",
      "Bash(bin/rails db:drop*)",
      "Bash(bin/rails db:create*)",
      "Bash(bin/rails db:schema:load*)",
      "Bash(rails db:migrate*)",
      "Bash(rails db:rollback*)",
      "Bash(rails db:prepare*)",
      "Bash(rails db:reset*)",
      "Bash(rails db:setup*)",
      "Bash(rails db:seed*)",
      "Bash(rails db:drop*)",
      "Bash(rails db:create*)",
      "Bash(rails db:schema:load*)",
      "Bash(bundle exec rails db:migrate*)",
      "Bash(bundle exec rails db:rollback*)",
      "Bash(bundle exec rails db:prepare*)",
      "Bash(bundle exec rails db:reset*)",
      "Bash(bundle exec rails db:setup*)",
      "Bash(bundle exec rails db:seed*)",
      "Bash(bundle exec rails db:drop*)",
      "Bash(bundle exec rails db:create*)",
      "Bash(bundle exec rails db:schema:load*)",
      "Bash(bundle exec rake db:migrate*)",
      "Bash(bundle exec rake db:rollback*)",
      "Bash(bundle exec rake db:prepare*)",
      "Bash(bundle exec rake db:reset*)",
      "Bash(bundle exec rake db:setup*)",
      "Bash(bundle exec rake db:seed*)",
      "Bash(bundle exec rake db:drop*)",
      "Bash(bundle exec rake db:create*)",
      "Bash(bundle exec rake db:schema:load*)",
      "Read(/config/application.yml)",
      "Read(/config/database.yml)",
      "Read(/config/secrets.yml)",
      "Read(/config/master.key)",
      "Read(/config/credentials/*.key)",
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/.env.development)",
      "Read(/.env.test)",
      "Read(/.env.production)",
      "Read(/.env.staging)",
      "Read(/.env.investigation)",
      "Read(/.env.*.local)",
      "Read(/log/**)",
      "Read(/logs/**)",
      "Read(/greenmask/dumps/**)",
      "Read(**/*.dump)",
      "Read(**/*.sql.gz)",
      "Read(/local_docs/agent_setup/login.local.md)"
    ]
  },
  "sandbox": {
    "enabled": true
  }
}
