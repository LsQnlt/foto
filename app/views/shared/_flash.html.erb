<%
  config = {
    'danger' => {
      icon_close_classes: 'text-red-700 hover:text-gray-700',
      icon_bg: 'bg-red-500',
      bg: 'bg-red-100',
      text: 'text-red-700',
      icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-white">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
            </svg>'
    },
    'info' => {
      icon_close_classes: 'text-primary hover:text-gray-700',
      icon_bg: 'bg-primary',
      bg: 'bg-blue-100',
      text: 'text-blue-dark',
      icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-white">
              <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
            </svg>'
    },
    'warning' => {
      icon_close_classes: 'text-yellow-600 hover:text-gray-700',
      icon_bg: 'bg-yellow',
      bg: 'bg-yellow-100',
      text: 'text-yellow-600',
      icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-yellow-600">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
            </svg>'
    },
    'success' => {
      icon_close_classes: 'text-green-dark hover:text-gray-700',
      icon_bg: 'bg-green',
      bg: 'bg-green-100',
      text: 'text-green-dark',
      icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-white">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>'
    },
    'notice' => {
      icon_close_classes: 'text-blue-700 hover:text-gray-700',
      icon_bg: 'bg-blue-500',
      bg: 'bg-blue-100',
      text: 'text-blue-700',
      icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-white">
              <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
            </svg>'
    },
    'alert' => {
      icon_close_classes: 'text-red-700 hover:text-gray-700',
      icon_bg: 'bg-red-300',
      bg: 'bg-red-100',
      text: 'text-red-700',
      icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-white">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
            </svg>'
    }
  }[flash_type] || {}
%>
<div id="toast_<%= index %>" class="flex w-full max-w-xs items-center justify-end rounded-xl drop-shadow-xl animate-in" role="alert">
  <div class="flex h-full items-center rounded-l-xl p-5 <%= config[:icon_bg] %>">
    <span class="">
      <%= config[:icon].html_safe %>
    </span>
  </div>
  <div class="flex h-full grow items-center rounded-r-xl p-5 <%= config[:bg] %>">
    <div class="mr-2 <%= config[:text] %>"><%= message %></div>
    <button
      type="button"
      class="inline-flex h-8 w-8 items-center justify-center rounded-lg border-none bg-transparent p-1.5 focus:ring-2 focus:ring-gray-300"
      aria-label="Close"
      onclick="document.getElementById('toast_<%= index %>').remove()"
    >
      <span class="sr-only">Close</span>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 <%= config[:icon_close_classes] %>">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[id^="toast_"]').forEach((toast) => {
      setTimeout(() => {
        toast.remove();
      }, 6500);
    });
  });
</script>
