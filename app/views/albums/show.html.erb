<div data-controller="gallery" class="flex w-full">
  <!-- Header album -->
  <div class="min-w-0 pt-16 pb-6 text-center">
    <h1 class="text-4xl font-bold mb-2"><%= @album.title %></h1>
    <p class="text-gray-500 text-lg"><%= @album.created_at.to_date %></p>
  </div>
  <!-- Grille de photos -->
  <div class="max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 p-4">
    <% @photos.each_with_index do |photo, idx| %>
      <% cache(photo) do %>
        <div class="rounded-2xl overflow-hidden bg-white shadow group relative">
          <% if photo.image.attached? %>
            <%= image_tag photo.thumb_variant(method: :resize_to_fill), alt: "Photo", loading: "lazy",
            class: "gallery-photo w-full h-64 object-cover transition-transform duration-300 group-hover:scale-105 cursor-pointer",
            data: {
              action: "click->gallery#open mouseenter->gallery#hoverPreload",
              photo_index: idx,
              photo_id: photo.id,
              liked: @liked_photos.include?(photo.id),
              full_url: "#{url_for(photo.lightbox_variant)}?track=lightbox",
              alt: "foto.rip - #{@album.title} #{idx}"
              }
            %>
            <!-- Like compteur en overlay, coin bas droite -->
            <% if photo.likes_count.present? && photo.likes_count > 0 %>
              <div class="absolute bottom-4 right-4 flex items-center gap-1 bg-white/80 px-2 py-1 rounded-full shadow z-10">
                <!-- Icone cœur -->
                <svg class="w-5 h-5 text-pink-500" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41 0.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
                <span class="like-count text-xs font-bold text-pink-500"><%= photo.likes_count %></span>
              </div>
            <% end %>
          <% else %>
            <div class="w-full h-64 flex items-center justify-center bg-gray-100 text-gray-400 text-3xl">
              <span>📷</span>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
  <!-- Modale pour la lightbox -->
  <div
    id="gallery-modal"
    data-gallery-target="modal"
    class="fixed inset-0 z-50 hidden"
  ></div>
</div>
