<div class="flex w-full">
  <!-- Header album -->
  <div class="max-w-2xl mx-auto pt-16 pb-6 text-center">
    <h1 class="text-4xl font-bold mb-2"><%= @album.title %></h1>
    <p class="text-gray-500 text-lg"><%= @album.description %></p>
  </div>

  <!-- Grille de photos -->
  <div class="max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 p-4">
    <% @album.photos.each do |photo| %>
      <div class="rounded-2xl overflow-hidden bg-white shadow group relative">
        <% if photo.image.attached? %>
          <%= image_tag url_for(photo.image), class: "w-full h-64 object-cover transition-transform duration-300 group-hover:scale-105" %>
        <% else %>
          <div class="w-full h-64 flex items-center justify-center bg-gray-100 text-gray-400 text-3xl">
            <span>📷</span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
