<div class="flex justify-center mt-24">
  <div class="text-center">
    <h1>Entrer le mot de passe pour accéder à l’album</h1>
    <%= form_with url: verify_password_user_album_path(@album, pseudonym: params[:pseudonym]), method: :post, class: "mt-5 space-y-6" do %>
      <%= password_field_tag :password, nil, class: "w-1/2 border border-gray-300 rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      <%= submit_tag "Valider", class: "bg-main-dark text-white font-semibold px-6 py-2 rounded-md hover:bg-main-darkened transition duration-150"  %>
    <% end %>
  </div>
</div>
