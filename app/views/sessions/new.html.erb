<%= form_with url: session_path,  class: "space-y-6 w-1/3" do |form| %>
  <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "Entrez votre email", class: "w-full border border-gray-300 rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", value: params[:email_address]  %><br>
  <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Entrez votre mot de passe", class: "w-full border border-gray-300 rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", maxlength: 72 %><br>
  <%= form.submit "Connectez vous", class: "mt-4 bg-main text-white font-semibold px-6 py-2 rounded-md hover:bg-main-darkened transition duration-150" %>
<% end %>
<br>
