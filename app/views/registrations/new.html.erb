<h1 class="text-2xl font-semibold mb-6">Créer votre compte</h1>
<%= form_with model: @user, url: user_registration_path(token: params[:token]), class: "space-y-6 w-1/3" do |form| %>
  <%= form.hidden_field :email_address %>
  <div>
    <%= form.label :pseudonym, "Pseudonyme", class: "block font-semibold mb-1" %>
    <%= form.text_field :pseudonym, required: true, class: "w-full border border-gray-300 rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>
  <div>
    <%= form.label :password, "Mot de passe", class: "block font-semibold mb-1" %>
    <%= form.password_field :password, required: true, class: "w-full border border-gray-300 rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>
  <div>
    <%= form.label :password_confirmation, "Confirmation du mot de passe", class: "block font-semibold mb-1" %>
    <%= form.password_field :password_confirmation, required: true, class: "w-full border border-gray-300 rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>
  <%= form.submit "Créer mon compte", class: "mt-4 bg-main text-white font-semibold px-6 py-2 rounded-md hover:bg-main-darkened transition duration-150" %>
<% end %>
